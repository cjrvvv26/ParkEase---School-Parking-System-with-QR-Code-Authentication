{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "scheme": "parkease",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkease.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.parkease.mobile"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
