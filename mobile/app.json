{
  "expo": {
    "name": "School Parking System",
    "slug": "mobile",
    "scheme": "parkease",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/images/urs-logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./app/assets/images/urs-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#8e51ff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./app/assets/images/urs-logo.jpg",
          "color": "#3b82f6",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkease.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.parkease.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "75a3627c-4553-48dd-b311-c52742b6c463"
      },
      "API_URL": "https://parkease-school-parking-system-with-qr-nn18.onrender.com"
    }
  }
}
